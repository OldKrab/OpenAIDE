{
  "name": "openaide-vscode-notification-companion",
  "displayName": "OpenAIDE System Notifications",
  "description": "Presents local operating-system notifications for OpenAIDE remote workspaces.",
  "version": "0.0.0",
  "publisher": "openaide",
  "license": "AGPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/OldKrab/OpenAIDE.git"
  },
  "type": "commonjs",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.100.0"
  },
  "api": "none",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onCommand:_openaide.notifications.show",
    "onCommand:openaide.testSystemNotification"
  ],
  "contributes": {
    "commands": [
      {
        "command": "openaide.testSystemNotification",
        "title": "OpenAIDE: Test System Notification"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
