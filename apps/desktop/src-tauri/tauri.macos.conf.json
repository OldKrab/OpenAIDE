{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenAIDE",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f8fafc",
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 14, "y": 16 }
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "dmg": {
        "background": "dmg-background.png",
        "windowPosition": { "x": 200, "y": 160 },
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 165, "y": 225 },
        "applicationFolderPosition": { "x": 495, "y": 225 }
      }
    }
  }
}
