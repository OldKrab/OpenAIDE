{
  "name": "openaide-desktop",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && npm run build:renderers",
    "build:renderers": "vite build --config ../../packages/frontend/vite.pdf-renderer.config.ts --emptyOutDir=false",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "vite",
    "tauri": "tauri",
    "test": "vitest run frontend/*.test.ts && node --test scripts/development-launch.test.mjs"
  },
  "dependencies": {
    "@openaide/app-server-client": "*",
    "@openaide/app-shell-contracts": "*",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-notification": "2.7.0",
    "@tauri-apps/plugin-opener": "2.7.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
